project_id                         = "weather-alerts-panda"
region                             = "us-east1"
service_name                       = "weather-alert-backend"
artifact_registry_repository_id    = "weather-alert-backend"
cloud_sql_instance_name            = "weather-alert-db"
cloud_sql_database_version         = "POSTGRES_15"
cloud_sql_tier                     = "db-custom-1-3840"
cloud_sql_availability_type        = "ZONAL"
cloud_sql_disk_size_gb             = 20
cloud_sql_deletion_protection      = true
database_name                      = "weather_alerts"
database_user                      = "weather_app"
frontend_base_url                  = "https://your-frontend.example.com"
mail_host                          = "smtp.example.com"
mail_port                          = "587"
mail_username                      = "smtp-user"
mail_from_address                  = "no-reply@example.com"
stripe_enabled                     = false
stripe_price_id                    = ""
stripe_plus_price_id               = ""
stripe_pro_price_id                = ""
stripe_success_url                 = ""
stripe_cancel_url                  = ""

# Leave false if you want to create Cloud Scheduler jobs later.
create_scheduler_jobs = true

# Sensitive values. If you use a remote Terraform backend, secure the state.
database_password = "replace-me"
user_password     = "replace-me"
admin_password    = "replace-me"
jwt_secret        = "replace-with-at-least-32-characters"
mail_password     = "replace-me"
admin_jobs_token  = "replace-with-a-long-random-token"
stripe_secret_key = ""
stripe_webhook_secret = ""
